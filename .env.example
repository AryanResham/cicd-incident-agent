# App settings (all optional). The app reads real environment variables only: export them in your
# shell or use `docker run --env-file .env`. No secrets here: the pipeline's secrets
# (RENDER_DEPLOY_HOOK_URL, GEMINI_API_KEY, AGENT_TOKEN) live in GitHub Actions secrets.

# SQLite file. In the Docker image the process runs in /app/data, so the default ends up there.
DATABASE_PATH=./todos.db

# What "today" means for deadlines (any IANA time zone name).
APP_TIMEZONE=Asia/Kolkata

# Port uvicorn listens on inside the container (Render sets its own).
PORT=8000

# Reported by /health. The image build sets it to the commit SHA.
APP_VERSION=dev
